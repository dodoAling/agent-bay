{
  "name": "agent-bay",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A local terminal-style cockpit for model APIs, MCP tools and external agents.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "desktop:prepare": "node scripts/desktop-prepare.mjs",
    "desktop:check": "node scripts/desktop-check.mjs",
    "desktop:dev": "node scripts/desktop-run.mjs dev",
    "desktop:build": "node scripts/desktop-run.mjs build",
    "build:reference": "node scripts/build-reference.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "build:video": "node scripts/build-video-vendor.mjs",
    "check:english": "node scripts/check-english.mjs",
    "test": "node --test test/*.test.mjs",
    "video": "node scripts/record-demo.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "esbuild": "^0.28.2",
    "html2canvas": "^1.4.1",
    "mediabunny": "^1.61.5",
    "playwright-core": "1.60.0"
  }
}
